<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OniDup</AssemblyName>
    <RootNamespace>OniDup</RootNamespace>
    <Version>0.1.0</Version>
    <IsOniMod>true</IsOniMod>
  </PropertyGroup>
  <ItemGroup>
    <!-- PLib provides the standard mod options window. It goes into the mod folder as a separate file next to OniDup.dll. -->
    <PackageReference Include="PLib" Version="4.25.0" />
    <ModLibrary Include="PLib.dll" />
    <!-- Code shared by our mods is compiled into each mod separately: the mods do not depend on each other. -->
    <Compile Include="../Common/ModContext.cs;../Common/ModLocalization.cs;../Common/MixtureUi.cs" LinkBase="Common" />
    <!-- Translations of the mod's own strings (ModStrings.cs), if any. -->
    <ModTranslations Include="translations/*.po" />
    <!-- The mixtures overlay icon (src/Common/MixtureUi.cs, drawn by scripts/draw_overlay_icon.py). -->
    <EmbeddedResource Include="../Common/overlay_mixtures.png" LogicalName="OniCommon.overlay_mixtures.png" />
  </ItemGroup>
</Project>
