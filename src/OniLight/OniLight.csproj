<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OniLight</AssemblyName>
    <RootNamespace>OniLight</RootNamespace>
    <Version>0.1.0</Version>
    <IsOniMod>true</IsOniMod>
  </PropertyGroup>
  <ItemGroup>
    <!-- Code shared by our mods is compiled into each mod separately: the mods do not depend on each other. -->
    <Compile Include="../Common/ModContext.cs;../Common/ModLocalization.cs;../Common/MolarMasses.cs" LinkBase="Common" />
    <!-- PLib provides the standard mod options dialog. It goes into the mod folder as a separate file next to OniLight.dll. -->
    <PackageReference Include="PLib" Version="4.25.0" />
    <ModLibrary Include="PLib.dll" />
    <!-- Translations of the mod's own strings (ModStrings.cs), if any. -->
    <ModTranslations Include="translations/*.po" />
    <!-- The light engine (native/oni_light.cpp, scripts/build-native.sh). Without it the mod leaves the game's light alone. -->
    <ModExtraFiles Include="../../native/build/oni_light.bin" Condition="Exists('../../native/build/oni_light.bin')" />
  </ItemGroup>
</Project>
