<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OniGasMix</AssemblyName>
    <RootNamespace>OniGasMix</RootNamespace>
    <Version>0.1.0</Version>
    <IsOniMod>true</IsOniMod>
  </PropertyGroup>
  <ItemGroup>
    <!-- The common code of our mods is compiled into each mod separately: the mods do not depend on each other. -->
    <Compile Include="../Common/ModContext.cs;../Common/ModLocalization.cs;../Common/AbTest.cs;../Common/PlayerLoopUtil.cs;../Common/SimHooks.cs;../Common/ElementRecords.cs;../Common/MolarMasses.cs;../Common/MixtureUi.cs" LinkBase="Common" />
    <!-- PLib provides the standard mod settings window. It goes into the mod folder as a separate file next to OniGasMix.dll. -->
    <PackageReference Include="PLib" Version="4.25.0" />
    <ModLibrary Include="PLib.dll" />
    <!-- Hooks on simulation functions (sim/build.sh): the common engine and the layer plugin. Without them the mod changes nothing. -->
    <ModExtraFiles Include="../../sim/build/oni_simhook.bin" Condition="Exists('../../sim/build/oni_simhook.bin')" />
    <ModExtraFiles Include="../../sim/build/oni_gasmix.bin" Condition="Exists('../../sim/build/oni_gasmix.bin')" />
    <!-- Translations of the mod's own strings (ModStrings.cs), if any. -->
    <ModTranslations Include="translations/*.po" />
    <!-- The mixtures overlay icon (src/Common/MixtureUi.cs, drawn by scripts/draw_overlay_icon.py). -->
    <EmbeddedResource Include="../Common/overlay_mixtures.png" LogicalName="OniCommon.overlay_mixtures.png" />
  </ItemGroup>
</Project>
