<Project>
  <!-- Game paths. Overridden with the environment variables ONI_GAME_DIR / ONI_USER_DIR. -->
  <PropertyGroup>
    <SteamDir Condition="'$(SteamDir)' == ''">$(HOME)/.local/share/Steam</SteamDir>
    <GameDir Condition="'$(ONI_GAME_DIR)' != ''">$(ONI_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(SteamDir)/steamapps/common/OxygenNotIncluded</GameDir>
    <ManagedDir>$(GameDir)/OxygenNotIncluded_Data/Managed</ManagedDir>
    <!-- The game runs under Proton, so "Documents" lives inside the prefix. -->
    <UserDir Condition="'$(ONI_USER_DIR)' != ''">$(ONI_USER_DIR)</UserDir>
    <UserDir Condition="'$(UserDir)' == ''">$(SteamDir)/steamapps/compatdata/457140/pfx/drive_c/users/steamuser/Documents/Klei/OxygenNotIncluded</UserDir>
    <DevModsDir>$(UserDir)/mods/Dev</DevModsDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <!-- The game is built for .NET 4.8, and the Unity modules have no versions: silence the mismatch noise. -->
    <NoWarn>$(NoWarn);MSB3277;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework reference assemblies for building on Linux without Mono. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Exposes private members of the game assemblies at compile time: we write plain code instead of reflection.
         Unity Mono does not check access at runtime. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game assemblies: references only, not copied into the mod. -->
    <Reference Include="Assembly-CSharp" Publicize="true"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass" Publicize="true"><HintPath>$(ManagedDir)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ManagedDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(ManagedDir)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(ManagedDir)/UnityEngine.Physics2DModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(ManagedDir)/netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
